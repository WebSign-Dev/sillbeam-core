{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getsillbeam.websign.de/schemas/core-data-common.v1.schema.json",
  "title": "Sillbeam Core v0.4 – common data definitions v1",
  "$defs": {
    "metadata": {
      "type": "object",
      "properties": {
        "core_version": {
          "type": "string",
          "minLength": 1
        },
        "analysis_run_id": {
          "type": "string",
          "format": "uuid"
        },
        "analyzed_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "php_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "symfony_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "architecture_fingerprint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:v[1-9]\\d*:[0-9a-f]{64}$"
        },
        "fingerprint_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "core_version",
        "analysis_run_id",
        "analyzed_at",
        "duration_ms",
        "php_version",
        "symfony_version",
        "architecture_fingerprint",
        "fingerprint_version"
      ],
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "properties": {
        "resource_key": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "source_locale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "resource_key",
        "locale",
        "source_locale"
      ],
      "additionalProperties": false
    },
    "i18n": {
      "type": "object",
      "properties": {
        "default_locale": {
          "type": "string",
          "minLength": 1
        },
        "available_locales": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "included_locales": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "requested_locale": {
          "type": [
            "string",
            "null"
          ]
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "$ref": "core-data-common.v1.schema.json#/$defs/fallback"
          }
        }
      },
      "required": [
        "default_locale",
        "available_locales",
        "included_locales",
        "requested_locale",
        "fallbacks"
      ],
      "additionalProperties": false
    },
    "analysisStatus": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "valid",
            "violations",
            "unavailable"
          ]
        },
        "valid": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "valid",
        "complete"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "valid"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "valid": {
                "const": true
              },
              "complete": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "violations"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "valid": {
                "const": false
              },
              "complete": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "valid": {
                "const": false
              },
              "complete": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "exportStatus": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "module_count": {
          "type": "integer",
          "minimum": 0
        },
        "project_count": {
          "type": "integer",
          "minimum": 0
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "diagnosis_count": {
          "type": "integer",
          "minimum": 0
        },
        "module_reference_count": {
          "type": "integer",
          "minimum": 0
        },
        "application_reference_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "module_count",
        "project_count",
        "finding_count",
        "diagnosis_count",
        "module_reference_count",
        "application_reference_count"
      ],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "override_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "enabled_override": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "override_source",
        "enabled_override"
      ],
      "additionalProperties": false
    },
    "projectState": {
      "type": "object",
      "properties": {
        "project_class": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "disabled",
            "unassigned",
            "unknown"
          ]
        }
      },
      "required": [
        "project_class",
        "state"
      ],
      "additionalProperties": false
    },
    "module": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "shared",
            "private"
          ]
        },
        "project": {
          "type": [
            "string",
            "null"
          ]
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "descriptor": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "active": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "inactive_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "disabled",
            "unassigned",
            "unknown",
            null
          ]
        },
        "declared_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observed_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "activation_reasons": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "controllers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "configuration": {
          "$ref": "core-data-common.v1.schema.json#/$defs/configuration"
        },
        "project_states": {
          "type": "array",
          "items": {
            "$ref": "core-data-common.v1.schema.json#/$defs/projectState"
          }
        }
      },
      "required": [
        "id",
        "class",
        "description",
        "namespace",
        "scope",
        "project",
        "directory",
        "descriptor",
        "enabled",
        "active",
        "inactive_reason",
        "declared_dependencies",
        "observed_dependencies",
        "activation_reasons",
        "controllers",
        "entities",
        "configuration",
        "project_states"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "directory": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "descriptor": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "declared_modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "modules": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "controllers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "class",
        "description",
        "namespace",
        "directory",
        "descriptor",
        "declared_modules",
        "modules",
        "hosts",
        "controllers",
        "entities"
      ],
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "$ref": "core-data-common.v1.schema.json#/$defs/module"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "core-data-common.v1.schema.json#/$defs/project"
          }
        }
      },
      "required": [
        "modules",
        "projects"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "path",
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "findingTranslations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      },
      "patternProperties": {
        "^[a-z]{2}(?:-[A-Z]{2})?$": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "hint": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "message",
            "hint"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "diagnosisTranslations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      },
      "patternProperties": {
        "^[a-z]{2}(?:-[A-Z]{2})?$": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "problem": {
              "type": "string"
            },
            "impact": {
              "type": "string"
            },
            "caution": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "title",
            "category",
            "problem",
            "impact",
            "caution"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "detailTranslations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      },
      "patternProperties": {
        "^[a-z]{2}(?:-[A-Z]{2})?$": {
          "type": "object",
          "properties": {
            "problem": {
              "type": "string"
            },
            "impact": {
              "type": "string"
            }
          },
          "required": [
            "problem",
            "impact"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "resolutionTranslations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      },
      "patternProperties": {
        "^[a-z]{2}(?:-[A-Z]{2})?$": {
          "type": "object",
          "properties": {
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "steps"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "doctorTranslations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      },
      "patternProperties": {
        "^[a-z]{2}(?:-[A-Z]{2})?$": {
          "type": "object",
          "properties": {
            "description": {
              "type": "string"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "description",
            "detail"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "errorTranslations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$"
      },
      "patternProperties": {
        "^[a-z]{2}(?:-[A-Z]{2})?$": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            }
          },
          "required": [
            "message"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "finding": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "fatal"
          ]
        },
        "message": {
          "type": "string"
        },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          }
        },
        "location": {
          "oneOf": [
            {
              "$ref": "core-data-common.v1.schema.json#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnosis_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "translations": {
          "$ref": "core-data-common.v1.schema.json#/$defs/findingTranslations"
        }
      },
      "required": [
        "index",
        "rule",
        "severity",
        "message",
        "context",
        "location",
        "diagnosis_id",
        "translations"
      ],
      "additionalProperties": false
    },
    "diagnosisDetail": {
      "type": "object",
      "properties": {
        "finding_index": {
          "type": "integer",
          "minimum": 0
        },
        "caution": {
          "type": "boolean"
        },
        "translations": {
          "$ref": "core-data-common.v1.schema.json#/$defs/detailTranslations"
        }
      },
      "required": [
        "finding_index",
        "caution",
        "translations"
      ],
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "technical",
            "option"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "uniqueItems": true
        },
        "configuration": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "translations": {
          "$ref": "core-data-common.v1.schema.json#/$defs/resolutionTranslations"
        }
      },
      "required": [
        "id",
        "kind",
        "files",
        "configuration",
        "translations"
      ],
      "additionalProperties": false
    },
    "diagnosis": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "correlation_key": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:v[1-9]\\d*:[0-9a-f]{64}$"
        },
        "correlation_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "enum": [
            "finding",
            "declared_cycle",
            "declared_dependency",
            "observed_reference",
            "disabled_module",
            "duplicate_module_key",
            "duplicate_project_id",
            "host_assignment"
          ]
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "fatal"
          ]
        },
        "rule_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "finding_indexes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "modules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "descriptors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        },
        "details": {
          "type": "array",
          "items": {
            "$ref": "core-data-common.v1.schema.json#/$defs/diagnosisDetail"
          }
        },
        "translations": {
          "$ref": "core-data-common.v1.schema.json#/$defs/diagnosisTranslations"
        },
        "resolutions": {
          "type": "array",
          "items": {
            "$ref": "core-data-common.v1.schema.json#/$defs/resolution"
          }
        }
      },
      "required": [
        "id",
        "correlation_key",
        "correlation_version",
        "basis",
        "severity",
        "rule_codes",
        "finding_indexes",
        "modules",
        "descriptors",
        "details",
        "translations",
        "resolutions"
      ],
      "additionalProperties": false
    },
    "diagnostics": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "$ref": "core-data-common.v1.schema.json#/$defs/finding"
          }
        },
        "diagnoses": {
          "type": "array",
          "items": {
            "$ref": "core-data-common.v1.schema.json#/$defs/diagnosis"
          }
        }
      },
      "required": [
        "findings",
        "diagnoses"
      ],
      "additionalProperties": false
    },
    "moduleReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_module": {
          "type": "string",
          "minLength": 1
        },
        "target_module": {
          "type": "string",
          "minLength": 1
        },
        "target_class": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "declared": {
          "type": "boolean"
        },
        "observed": {
          "const": true
        }
      },
      "required": [
        "id",
        "source_module",
        "target_module",
        "target_class",
        "source_file",
        "source_line",
        "declared",
        "observed"
      ],
      "additionalProperties": false
    },
    "applicationReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_module": {
          "type": "string",
          "minLength": 1
        },
        "target_class": {
          "type": "string",
          "minLength": 1
        },
        "source_file": {
          "type": "string",
          "minLength": 1,
